ENVIRONMENT=development
# Local PostgreSQL or Neon connection string. Keep secrets out of Git.
DATABASE_URL=postgresql+psycopg://stayfinder:change-this-local-password@localhost:5432/stayfinder
SECRET_KEY=generate-a-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ACCESS_MINUTES=30
REFRESH_DAYS=14
SERVICE_FEE_RATE=0.10
TAX_RATE=0.05

# Email (SMTP). For Gmail, use smtp.gmail.com, port 587, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Stripe test keys first. Webhook URL: /api/v1/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=usd

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Durable image storage (recommended for production). Set UPLOAD_PROVIDER=cloudinary
# and provide all three Cloudinary values. Local disk is used otherwise.
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated emails allowed to receive admin role at registration
ADMIN_EMAILS=
